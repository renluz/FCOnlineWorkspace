{
  "name": "fconline-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready MCP server for FC Online OpenAPI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fconline-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "dev": "tsx src/server.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}